{
  "manifest_version": 3,
  "name": "MyChat ChatGPT Subscription Bridge",
  "version": "0.1.0",
  "description": "Connect MyChat Long Think to the ChatGPT web session already signed in in this browser.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://chatgpt.com/*"],
      "js": ["content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "MyChat ChatGPT Bridge"
  }
}
